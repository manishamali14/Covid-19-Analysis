ove invalid negative cumulative values\n","\n","cumulative_columns = {\n","    \"Country Wise\": country_wise,\n","    \"Day Wise\": day_wise,\n","    \"Full Grouped\": full_grouped,\n","    \"COVID Clean\": covid_clean,\n","    \"Worldometer\": worldometer\n","}\n","\n","\n","cumulative_fields = [\n","    \"Confirmed\",\"Deaths\",\"Recovered\",\"TotalCases\",\"TotalDeaths\",\"TotalRecovered\",\n","    \"ActiveCases\"\n","]\n","\n","\n","for df in cumulative_columns.values():\n","\n","    for col in cumulative_fields:\n","\n","        if col in df.columns:\n","\n","            df.loc[\n","                df[col] < 0,\n","                col\n","            ] = np.nan\n","\n","\n","# Handle logically invalid COVID values\n","\n","for df in cumulative_columns.values():\n","\n","    if all(\n","        col in df.columns\n","        for col in [\n","            \"Confirmed\",\"Deaths\",\"Recovered\"\n","        ]\n","    ):\n","\n","        df.loc[\n","            df[\"Deaths\"] > df[\"Confirmed\"],\n","            \"Deaths\"\n","        ] = np.nan\n","\n","        df.loc[\n","            df[\"Recovered\"] > df[\"Confirmed\"],\n","            \"Recovered\"\n","        ] = np.nan\n","\n","\n","# Validate geographic coordinates\n","\n","for df in [covid_clean, usa_county]:\n","\n","    if \"Lat\" in df.columns:\n","\n","        df.loc[\n","            ~df[\"Lat\"].between(-90, 90),\n","            \"Lat\"\n","        ] = np.nan\n","\n","    if \"Long\" in df.columns:\n","\n","        df.loc[\n","            ~df[\"Long\"].between(-180, 180),\n","            \"Long\"\n","        ] = np.nan\n","\n","\n","# Worldometer-specific imputation\n","\n","if all(\n","    col in worldometer.columns\n","    for col in [\n","        \"TotalCases\",\"TotalDeaths\",\"TotalRecovered\",\"ActiveCases\"\n","    ]\n","):\n","\n","    zero_death_condition = (\n","        worldometer[\"TotalDeaths\"].isna()\n","        & worldometer[\"TotalRecovered\"].notna()\n","        & worldometer[\"ActiveCases\"].notna()\n","        &\n","        (\n","            worldometer[\"TotalCases\"]\n","            ==\n","            worldometer[\"TotalRecovered\"]\n","            + worldometer[\"ActiveCases\"]\n","        )\n","    )\n","\n","    worldometer.loc[\n","        zero_death_condition,\n","        \"TotalDeaths\"\n","    ] = 0\n","\n","\n","# Dataset-specific duplicate checks\n","\n","duplicate_keys = {\n","    \"Day Wise\": day_wise.duplicated(\n","        subset=[\"Date\"]\n","    ).sum(),\n","\n","    \"Full Grouped\": full_grouped.duplicated(\n","        subset=[\"Date\", \"Country/Region\"]\n","    ).sum(),\n","\n","    \"Country Wise\": country_wise.duplicated(\n","        subset=[\"Country/Region\"]\n","    ).sum(),\n","\n","    \"COVID Clean\": covid_clean.duplicated(\n","        subset=[\n","            \"Date\",\"Country/Region\",\"Province/State\"\n","        ]\n","    ).sum(),\n","\n","    \"USA County\": usa_county.duplicated(\n","        subset=[\"Date\", \"UID\"]\n","    ).sum(),\n","\n","    \"Worldometer\": worldometer.duplicated(\n","        subset=[\"Country/Region\"]\n","    ).sum()\n","}\n","\n","\n","# Remove duplicate business-key records if found\n","\n","if duplicate_keys[\"Day Wise\"] > 0:\n","    day_wise = day_wise.drop_duplicates(\n","        subset=[\"Date\"],\n","        keep=\"first\"\n","    )\n","\n","if duplicate_keys[\"Full Grouped\"] > 0:\n","    full_grouped = full_grouped.drop_duplicates(\n","        subset=[\"Date\", \"Country/Region\"],\n","        keep=\"first\"\n","    )\n","\n","if duplicate_keys[\"Country Wise\"] > 0:\n","    country_wise = country_wise.drop_duplicates(\n","        subset=[\"Country/Region\"],\n","        keep=\"first\"\n","    )\n","\n","if duplicate_keys[\"COVID Clean\"] > 0:\n","    covid_clean = covid_clean.drop_duplicates(\n","        subset=[\n","            \"Date\",\"Country/Region\",\"Province/State\"\n","        ],\n","        keep=\"first\"\n","    )\n","\n","if duplicate_keys[\"USA County\"